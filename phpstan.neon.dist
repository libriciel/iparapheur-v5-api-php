includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    checkMissingIterableValueType: false
    level: max
    paths:
        - src
        - tests
    ignoreErrors:
        -
            message: '#GenericObjectApi::get.* has no return type specified.#'
            path: src/GenericObjectApi.php
        -
            message: '#GenericObjectApi::post.* has no return type specified.#'
            path: src/GenericObjectApi.php